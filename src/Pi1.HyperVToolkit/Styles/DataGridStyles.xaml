<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="clr-namespace:Pi1.HyperVToolkit.Behaviors">
    <!--
        Global DataGrid presentation policy (single source of truth):
        human-readable localized headers, centered headers and normal cell
        values, content-aware Auto column widths, 10px side padding.
        Long free-form values (paths, descriptions) opt out per column with
        the LeftAlignedText style. Loaded by App.xaml and by UI tests.

        Centering note: DataGridCell.HorizontalContentAlignment alone does NOT
        center text — the generated TextBlock stretches across the cell while
        its own TextAlignment stays Left. The shared behavior (enabled below
        for every grid) assigns CenteredText, whose TextAlignment=Center is
        the actual fix. The explicit LeftAlignedText opt-out is preserved by
        reference; the WPF framework default text style is replaced.
    -->
    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="True" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AlternatingRowBackground" Value="#F5F5F5" />
        <Setter Property="CanUserResizeColumns" Value="True" />
        <Setter Property="CanUserSortColumns" Value="True" />
        <Setter Property="b:DataGridBehavior.EnableSharedBehavior" Value="True" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Content.Text}" />
    </Style>
    <!-- Centered read-only text cells (normal values). TextAlignment is the
         operative setter: the TextBlock stretches across the cell. Padding
         lives here (not on DataGridCell, whose stock template does not
         reliably honor it — measured) so values never touch borders. -->
    <Style x:Key="CenteredText" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <!-- Left-aligned exception for long free-form values (paths, descriptions). -->
    <Style x:Key="LeftAlignedText" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
</ResourceDictionary>
