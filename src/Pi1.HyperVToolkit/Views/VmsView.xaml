<UserControl x:Class="Pi1.HyperVToolkit.Views.VmsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Pi1.HyperVToolkit.Controls"
             xmlns:loc="clr-namespace:Pi1.HyperVToolkit.Localization">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <controls:LoadingIndicator LoadingText="{loc:Loc Key=Load_VMs}"
                                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
            <ItemsControl ItemsSource="{Binding NodeWarnings}"
                          Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibilityConverter}}"
                          Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:WarningBanner BannerText="{Binding}" Margin="0,0,0,6" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding StatusText}" Foreground="#616161" Margin="0,4,0,6" />
        </StackPanel>

        <TabControl SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="{loc:Loc Key=Tab_Overview}">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{loc:Loc Key=F_State}" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding StateOptions}" SelectedItem="{Binding StateFilter}"
                                  MinWidth="110" Margin="6,0,0,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource StatusValueConverter}, ConverterParameter=StateFilter}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{loc:Loc Key=F_Name}" VerticalAlignment="Center" Margin="14,0,0,0" />
                        <TextBox Text="{Binding NameFilter, UpdateSourceTrigger=PropertyChanged}"
                                 MinWidth="200" Margin="6,0,0,0" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DataGrid Grid.Column="0" ItemsSource="{Binding OverviewRows}"
                                  SelectedItem="{Binding SelectedVm}"
                                  AutoGenerateColumns="False" Margin="0,0,6,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="Auto" Header="{loc:Loc Key=H_HostNode}" Binding="{Binding HostNode}" />
                                <DataGridTextColumn Width="Auto" Header="{loc:Loc Key=H_VM}" Binding="{Binding VM}" />
                                <DataGridTextColumn Width="Auto" Header="{loc:Loc Key=H_State}" Binding="{Binding State, Converter={StaticResource StatusValueConverter}}" />
                                <DataGridTextColumn Width="Auto" Header="{loc:Loc Key=H_CPU}" Binding="{Binding CPU}" />
                                <DataGridTextColumn Width="Auto" Header="{loc:Loc Key=H_AssignedMemory}" Binding="{Binding AssignedBytes, Converter={StaticResource DataSizeConverter}}" />
                                <DataGridTextColumn Width="Auto" Header="{loc:Loc Key=H_DemandMemory}" Binding="{Binding DemandBytes, Converter={StaticResource DataSizeConverter}}" />
                                <DataGridTextColumn Width="Auto" Header="{loc:Loc Key=H_MemoryDifference}" Binding="{Binding WasteBytes, Converter={StaticResource DataSizeConverter}}" />
                                <DataGridTextColumn Width="Auto" Header="{loc:Loc Key=H_IPv4}" Binding="{Binding IPv4}" />
                                <DataGridTextColumn Width="Auto" Header="{loc:Loc Key=H_MAC}" Binding="{Binding MAC}" />
                                <DataGridTextColumn Width="Auto" Header="{loc:Loc Key=H_Switch}" Binding="{Binding Switch}" />
                                <DataGridTextColumn Width="Auto" Header="{loc:Loc Key=H_Uptime}" Binding="{Binding UptimeText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <GroupBox Grid.Column="1" Header="{loc:Loc Key=D_VMDetail}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="8" DataContext="{Binding SelectedVm}">
                                    <TextBlock Text="{Binding DataContext.SelectedVmTitle, RelativeSource={RelativeSource AncestorType=GroupBox}}" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Margin="0,6,0,0"><Run Text="{loc:Loc Key=H_HostNode}" /><Run Text=": " /><Run Text="{Binding Mode=OneWay, Path=HostNode}" /></TextBlock>
                                    <TextBlock><Run Text="{loc:Loc Key=H_State}" /><Run Text=": " /><Run Text="{Binding Mode=OneWay, Path=State, Converter={StaticResource StatusValueConverter}}" /></TextBlock>
                                    <TextBlock><Run Text="{loc:Loc Key=H_CPU}" /><Run Text=": " /><Run Text="{Binding Mode=OneWay, Path=CPU}" /></TextBlock>
                                    <TextBlock><Run Text="{loc:Loc Key=H_AssignedMemory}" /><Run Text=": " /><Run Text="{Binding Mode=OneWay, Path=AssignedBytes, Converter={StaticResource DataSizeConverter}}" /></TextBlock>
                                    <TextBlock><Run Text="{loc:Loc Key=H_DemandMemory}" /><Run Text=": " /><Run Text="{Binding Mode=OneWay, Path=DemandBytes, Converter={StaticResource DataSizeConverter}}" /></TextBlock>
                                    <TextBlock><Run Text="{loc:Loc Key=H_MemoryDifference}" /><Run Text=": " /><Run Text="{Binding Mode=OneWay, Path=WasteBytes, Converter={StaticResource DataSizeConverter}}" /></TextBlock>
                                    <TextBlock><Run Text="{loc:Loc Key=H_DynamicMemory}" /><Run Text=": " /><Run Text="{Binding Mode=OneWay, Path=Dynamic, Converter={StaticResource BoolYesNoConverter}}" /></TextBlock>
                                    <TextBlock><Run Text="{loc:Loc Key=H_StartupMemory}" /><Run Text=": " /><Run Text="{Binding Mode=OneWay, Path=StartupBytes, Converter={StaticResource DataSizeConverter}}" /></TextBlock>
                                    <TextBlock><Run Text="{loc:Loc Key=H_MinimumMemory}" /><Run Text=": " /><Run Text="{Binding Mode=OneWay, Path=MinimumBytes, Converter={StaticResource DataSizeConverter}}" /></TextBlock>
                                    <TextBlock><Run Text="{loc:Loc Key=H_MaximumMemory}" /><Run Text=": " /><Run Text="{Binding Mode=OneWay, Path=MaximumBytes, Converter={StaticResource DataSizeConverter}}" /></TextBlock>
                                    <TextBlock><Run Text="{loc:Loc Key=H_IPv4}" /><Run Text=": " /><Run Text="{Binding Mode=OneWay, Path=IPv4}" /></TextBlock>
                                    <TextBlock><Run Text="{loc:Loc Key=H_MAC}" /><Run Text=": " /><Run Text="{Binding Mode=OneWay, Path=MAC}" /></TextBlock>
                                    <TextBlock><Run Text="{loc:Loc Key=H_Switch}" /><Run Text=": " /><Run Text="{Binding Mode=OneWay, Path=Switch}" /></TextBlock>
                                    <TextBlock><Run Text="{loc:Loc Key=H_Uptime}" /><Run Text=": " /><Run Text="{Binding Mode=OneWay, Path=UptimeText}" /></TextBlock>
                                </StackPanel>
                            </ScrollViewer>
                        </GroupBox>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="{loc:Loc Key=Tab_Network}">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{loc:Loc Key=F_IP}" VerticalAlignment="Center" />
                        <TextBox Text="{Binding IpFilter, UpdateSourceTrigger=PropertyChanged}" MinWidth="170" Margin="6,0,0,0" />
                        <TextBlock Text="{loc:Loc Key=F_MAC}" VerticalAlignment="Center" Margin="14,0,0,0" />
                        <TextBox Text="{Binding MacFilter, UpdateSourceTrigger=PropertyChanged}" MinWidth="170" Margin="6,0,0,0" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding NetworkRows}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="Auto" Header="{loc:Loc Key=H_HostNode}" Binding="{Binding HostNode}" />
                            <DataGridTextColumn Width="Auto" Header="{loc:Loc Key=H_VMName}" Binding="{Binding VMName}" />
                            <DataGridTextColumn Width="Auto" Header="{loc:Loc Key=H_IPv4}" Binding="{Binding IPv4}" />
                            <DataGridTextColumn Width="Auto" Header="{loc:Loc Key=H_MacAddress}" Binding="{Binding MacAddress}" />
                            <DataGridTextColumn Width="Auto" Header="{loc:Loc Key=H_SwitchName}" Binding="{Binding SwitchName}" />
                            <DataGridTextColumn Width="*" Header="{loc:Loc Key=H_AllIPs}" Binding="{Binding AllIPs}" ElementStyle="{StaticResource LeftAlignedText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="{loc:Loc Key=Tab_Memory}">
                <DataGrid ItemsSource="{Binding MemoryRows}" AutoGenerateColumns="False" Margin="6">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="Auto" Header="{loc:Loc Key=H_HostNode}" Binding="{Binding HostNode}" />
                        <DataGridTextColumn Width="Auto" Header="{loc:Loc Key=H_VM}" Binding="{Binding VM}" />
                        <DataGridTextColumn Width="Auto" Header="{loc:Loc Key=H_State}" Binding="{Binding State, Converter={StaticResource StatusValueConverter}}" />
                        <DataGridCheckBoxColumn Width="Auto" Header="{loc:Loc Key=H_DynamicMemory}" Binding="{Binding Dynamic}" />
                        <DataGridTextColumn Width="Auto" Header="{loc:Loc Key=H_StartupMemory}" Binding="{Binding StartupBytes, Converter={StaticResource DataSizeConverter}}" />
                        <DataGridTextColumn Width="Auto" Header="{loc:Loc Key=H_MinimumMemory}" Binding="{Binding MinimumBytes, Converter={StaticResource DataSizeConverter}}" />
                        <DataGridTextColumn Width="Auto" Header="{loc:Loc Key=H_MaximumMemory}" Binding="{Binding MaximumBytes, Converter={StaticResource DataSizeConverter}}" />
                        <DataGridTextColumn Width="Auto" Header="{loc:Loc Key=H_AssignedMemory}" Binding="{Binding AssignedBytes, Converter={StaticResource DataSizeConverter}}" />
                        <DataGridTextColumn Width="Auto" Header="{loc:Loc Key=H_DemandMemory}" Binding="{Binding DemandBytes, Converter={StaticResource DataSizeConverter}}" />
                        <DataGridTextColumn Width="Auto" Header="{loc:Loc Key=H_MemoryDifference}" Binding="{Binding WasteBytes, Converter={StaticResource DataSizeConverter}}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="{loc:Loc Key=Tab_Checkpoints}">
                <DataGrid ItemsSource="{Binding CheckpointRows}" AutoGenerateColumns="False" Margin="6">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="Auto" Header="{loc:Loc Key=H_HostNode}" Binding="{Binding HostNode}" />
                        <DataGridTextColumn Width="Auto" Header="{loc:Loc Key=H_VM}" Binding="{Binding VM}" />
                        <DataGridTextColumn Width="Auto" Header="{loc:Loc Key=H_Name}" Binding="{Binding Name}" />
                        <DataGridTextColumn Width="Auto" Header="{loc:Loc Key=H_Created}" Binding="{Binding Created, Converter={StaticResource LocalizedDateConverter}}" />
                        <DataGridTextColumn Width="Auto" Header="{loc:Loc Key=H_Type}" Binding="{Binding Type}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="{loc:Loc Key=Tab_WithoutIP}">
                <DataGrid ItemsSource="{Binding WithoutIpRows}" AutoGenerateColumns="False" Margin="6">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="Auto" Header="{loc:Loc Key=H_HostNode}" Binding="{Binding HostNode}" />
                        <DataGridTextColumn Width="Auto" Header="{loc:Loc Key=H_VMName}" Binding="{Binding VMName}" />
                        <DataGridTextColumn Width="Auto" Header="{loc:Loc Key=H_MacAddress}" Binding="{Binding MacAddress}" />
                        <DataGridTextColumn Width="Auto" Header="{loc:Loc Key=H_SwitchName}" Binding="{Binding SwitchName}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
