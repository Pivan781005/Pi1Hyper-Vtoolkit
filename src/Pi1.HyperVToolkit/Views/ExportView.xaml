<UserControl x:Class="Pi1.HyperVToolkit.Views.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Pi1.HyperVToolkit.Controls"
             xmlns:loc="clr-namespace:Pi1.HyperVToolkit.Localization">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <controls:LoadingIndicator LoadingText="{loc:Loc Key=Load_Export}"
                                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
            <ItemsControl ItemsSource="{Binding NodeWarnings}"
                          Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibilityConverter}}"
                          Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:WarningBanner BannerText="{Binding}" Margin="0,0,0,6" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding StatusText}" Foreground="#616161" Margin="0,4,0,6" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="6" MaxWidth="640" HorizontalAlignment="Left">
                <TextBlock Text="{loc:Loc Key=Exp_CurrentTitle}" FontWeight="SemiBold" FontSize="14" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Key=Exp_Report}" Foreground="#616161" Margin="0,0,12,4" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentReportDisplayName}" ToolTip="{Binding CurrentReportName}" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Key=Exp_Rows}" Foreground="#616161" Margin="0,0,12,4" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentReportRows}" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Key=Exp_Scope}" Foreground="#616161" Margin="0,0,12,4" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ScopeLabel}" Margin="0,0,0,4" TextWrapping="Wrap" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="{loc:Loc Key=Exp_ExportCsv}" Command="{Binding ExportCurrentCsvCommand}" MinWidth="140" Margin="0,0,8,0" Padding="10,4" />
                    <Button Content="{loc:Loc Key=Exp_ExportHtml}" Command="{Binding ExportCurrentHtmlCommand}" MinWidth="140" Margin="0,0,8,0" Padding="10,4" />
                    <Button Content="{loc:Loc Key=Exp_ExportJson}" Command="{Binding ExportCurrentJsonCommand}" MinWidth="140" Padding="10,4" />
                </StackPanel>

                <TextBlock Text="{loc:Loc Key=Exp_FullTitle}" FontWeight="SemiBold" FontSize="14" Margin="0,24,0,0" />
                <TextBlock Text="{loc:Loc Key=Exp_FullDesc}" Foreground="#616161" Margin="0,4,0,0" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="{loc:Loc Key=Exp_ExportCsv}" Command="{Binding ExportFullVmCsvCommand}" MinWidth="140" Margin="0,0,8,0" Padding="10,4" />
                    <Button Content="{loc:Loc Key=Exp_ExportHtml}" Command="{Binding ExportFullVmHtmlCommand}" MinWidth="140" Margin="0,0,8,0" Padding="10,4" />
                    <Button Content="{loc:Loc Key=Exp_ExportJson}" Command="{Binding ExportFullVmJsonCommand}" MinWidth="140" Padding="10,4" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
