<UserControl x:Class="Pi1.HyperVToolkit.Controls.LoadingIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <ProgressBar IsIndeterminate="True" Width="140" Height="14" />
        <TextBlock Text="{Binding LoadingText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#616161" />
    </StackPanel>
</UserControl>
