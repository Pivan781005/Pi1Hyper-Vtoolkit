<Window x:Class="Pi1.HyperVToolkit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Pi1.HyperVToolkit.Controls"
        xmlns:core="clr-namespace:Pi1.HyperVToolkit.Core.Models;assembly=Pi1.HyperVToolkit.Core"
        xmlns:loc="clr-namespace:Pi1.HyperVToolkit.Localization"
        Title="π1 Hyper-V Toolkit" Height="900" Width="1700" MinHeight="650" MinWidth="1100"
        Icon="Assets/AppIcon.ico"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Top scope bar -->
        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="#E0E0E0" Padding="12,8" Background="#FAFAFA">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Key=Shell_Scope}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding ScopeOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Mode"
                              SelectedValue="{Binding SelectedScopeMode}"
                              MinWidth="190" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Loc Key=Shell_Node}" VerticalAlignment="Center" Margin="16,0,0,0" />
                    <TextBox Text="{Binding NodeName, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="170" Margin="8,0,0,0" VerticalAlignment="Center"
                             IsEnabled="{Binding IsNodeScope}" />
                    <Button Content="{loc:Loc Key=Shell_Apply}" Command="{Binding ApplyScopeCommand}" MinWidth="90" Margin="12,0,0,0" Padding="10,2" />
                    <Button Content="{loc:Loc Key=Shell_Refresh}" Command="{Binding RefreshCurrentCommand}" MinWidth="90" Margin="8,0,0,0" Padding="10,2" />
                    <Button Content="{loc:Loc Key=Shell_Cancel}" Command="{Binding CancelRefreshCommand}" MinWidth="90" Margin="8,0,0,0" Padding="10,2" />
                    <TextBlock Text="{Binding ScopeLabel}" Foreground="#616161" VerticalAlignment="Center" Margin="16,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding ScopeApplyMessage}" Foreground="#B26A00" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Bottom status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding AdminLabel}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding HyperVStatusText, FallbackValue='Hyper-V: …'}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding ClusterStatusText, FallbackValue='Cluster: …'}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding ScopeLabel}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <!-- Navigation + content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0"
                     ItemsSource="{Binding NavItems}"
                     SelectedItem="{Binding SelectedNavItem}"
                     BorderThickness="0,0,1,0"
                     Padding="4">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" Padding="8,7" FontSize="13" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <controls:WarningBanner Grid.Row="0"
                                        Severity="{x:Static core:Severity.Warning}"
                                        BannerText="{loc:Loc Key=Banner_HyperVUnavailable}"
                                        Detail="{Binding HyperVWarningText}"
                                        Visibility="{Binding HyperVWarningVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Margin="12,12,12,0" />
                <ContentControl Grid.Row="1" Content="{Binding CurrentView}" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
